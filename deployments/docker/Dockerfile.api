# DooLittle Health Patient Timeline API Dockerfile
# Author: Nithin Mohan T K (Example project for experimentation)
# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy csproj and restore dependencies
COPY ["src/DooLittle.Health.PatientTimeline.Api/DooLittle.Health.PatientTimeline.Api.csproj", "src/DooLittle.Health.PatientTimeline.Api/"]
RUN dotnet restore "src/DooLittle.Health.PatientTimeline.Api/DooLittle.Health.PatientTimeline.Api.csproj"

# Copy everything else and build
COPY . .
WORKDIR "/src/src/DooLittle.Health.PatientTimeline.Api"
RUN dotnet build "DooLittle.Health.PatientTimeline.Api.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "DooLittle.Health.PatientTimeline.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Copy data files from build context
COPY ["data/", "Data/"]

# Create non-root user and install curl for health checks
RUN adduser --disabled-password --gecos '' appuser && chown -R appuser:appuser /app && \
    apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
USER appuser

EXPOSE 8080
ENTRYPOINT ["dotnet", "DooLittle.Health.PatientTimeline.Api.dll"]